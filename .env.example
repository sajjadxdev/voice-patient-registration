# Application Settings
APP_NAME="Voice AI Patient Registration System"
DEBUG=false
PORT=8000
HOST="0.0.0.0"
API_BASE_URL="http://localhost:8000"

# Persistent Database Path (SQLite with WAL mode)
DATABASE_PATH="data/patients.db"

# LLM Providers (Optional: built-in intelligent dialogue state machine runs offline without keys)
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Vapi Integration (Optional)
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_ASSISTANT_ID=""

# Twilio Voice Integration (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Bonus Feature Toggles
ENABLE_DUPLICATE_CHECK=true
ENABLE_APPOINTMENTS=true
ENABLE_SPANISH_SUPPORT=true
